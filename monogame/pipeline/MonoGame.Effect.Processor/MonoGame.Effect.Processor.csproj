<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The MGCB plugin of WingSim's MonoGame fork: SpirvEffectProcessor (MonoGame's EffectProcessor over the fork's effect
    compiler). src/WingSim.Game/Content/Content.mgcb loads it with /reference from the fixed folder monogame/pipeline/bin
    (git-ignored), which therefore holds this assembly and MonoGame.Effect.Compiler.dll only: the content pipeline and
    framework assemblies are referenced from the dotnet-mgcb tool itself (not copied), so the plugin binds to exactly
    what MGCB has loaded.
  -->
  <PropertyGroup>
    <AssemblyName>MonoGame.Effect.Processor</AssemblyName>
    <RootNamespace>MonoGame.Effect.Processor</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)../bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MonoGame.Effect.Compiler/MonoGame.Effect.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MonoGame.Framework.Content.Pipeline" Aliases="ContentPipeline">
      <HintPath>$(WingSimMgcbTool)MonoGame.Framework.Content.Pipeline.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(WingSimMgcbTool)MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The tool comes from 'dotnet tool restore' (the Game build and CI run it; a first build of this project alone too). -->
  <Target Name="WingSimRestoreMgcbTool" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(WingSimMgcbTool)MonoGame.Framework.Content.Pipeline.dll')">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)../../.." />
    <Error Condition="!Exists('$(WingSimMgcbTool)MonoGame.Framework.Content.Pipeline.dll')" Text="The dotnet-mgcb $(WingSimMgcbVersion) tool is not at $(WingSimMgcbTool) after 'dotnet tool restore'." />
  </Target>
</Project>
