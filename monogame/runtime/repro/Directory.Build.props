<Project>
  <!--
    The repro programs are WingSim's own test code (not MonoGame's): they build with the repository's C# settings
    (net10.0, warnings as errors, analyzers), which monogame/runtime/Directory.Build.props keeps away from the C++
    project premake generates one folder up.
  -->
  <Import Project="../../../Directory.Build.props" />
</Project>
