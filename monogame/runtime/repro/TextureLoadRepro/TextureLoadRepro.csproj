<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Verification program of issue 011 of the fork (monogame/issues/011-texture-load-binding.md): a texture a pixel shader
    reads only with Load is bound, whether or not a sampler_state names it. Program.cs lists the checks; the exit code is
    the number that failed. Not part of the solution; needs the runtime fork built (monogame/runtime/build.sh).

      dotnet run -c Release (project monogame/runtime/repro/TextureLoadRepro)
      MG_HIDDEN_WINDOW=1 in the environment                       no window on the desktop
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <ProjectReference Include="../../../framework/MonoGame.Framework/MonoGame.Framework.Native.csproj" />
    <!-- The fork's effect processor, which Content/Content.mgcb loads: built first, not referenced. -->
    <ProjectReference Include="../../../pipeline/MonoGame.Effect.Processor/MonoGame.Effect.Processor.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup>
    <WingSimRuntimeRid Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</WingSimRuntimeRid>
    <WingSimRuntimeRid Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</WingSimRuntimeRid>
    <WingSimRuntimeRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</WingSimRuntimeRid>
    <WingSimRuntimeRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</WingSimRuntimeRid>
    <WingSimRuntimeDir>$(MSBuildThisFileDirectory)../../bin/$(WingSimRuntimeRid)/</WingSimRuntimeDir>
  </PropertyGroup>
  <!-- The fork's native library next to the executable. -->
  <Target Name="WingSimForkedRuntime" AfterTargets="Build" Condition="'$(WingSimRuntimeRid)' != ''">
    <Error Condition="!Exists('$(WingSimRuntimeDir)')" Text="Build the runtime fork first: monogame/runtime/build.sh." />
    <ItemGroup>
      <WingSimRuntimeFile Include="$(WingSimRuntimeDir)*mgruntime*" />
    </ItemGroup>
    <Copy SourceFiles="@(WingSimRuntimeFile)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
