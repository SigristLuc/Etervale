<Project>
  <!--
    MonoGame.Framework v3.8.6 (MS-PL), Native platform: MonoGame's code with WingSim's changes, not WingSim's own code.
    It does not import the repository's Directory.Build.props (WingSim's analyzers at latest-recommended, nullable
    reference types, implicit usings), which upstream code was never written against; it builds with MonoGame's own
    compiler settings (MonoGame.Framework.Native.csproj). Every compiler warning is still an error (CLAUDE.md), and the
    upstream warnings were fixed at their cause (monogame/framework/README.md).
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
