<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Tools" Version="2.81.1" PrivateAssets="All"/>
        <PackageReference Include="Google.Protobuf" Version="3.35.1"/>
        <PackageReference Include="Grpc.Core.Api" Version="2.80.0"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\**\*.proto" ProtoRoot="Protos" GrpcServices="Both"/>
    </ItemGroup>

</Project>
