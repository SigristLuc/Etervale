<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <!-- Upgrade the native SQLite lib past CVE-2025-6965 (GHSA-2m69-gcr7-jv3q; fixed in 3.50.2).
         Microsoft.Data.Sqlite pulls the 2.1.x native build transitively (the vulnerable 2.1.11 up to 10.0.9);
         pin the SQLite-versioned build.
         Resolved by UPGRADE, never by NuGetAuditSuppress. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PristonTale.Persistence\PristonTale.Persistence.csproj" />
  </ItemGroup>

</Project>
